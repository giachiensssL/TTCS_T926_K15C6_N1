# Environment variables – copy to .env and fill in real values

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── JWT ─────────────────────────────────────────────────────────────────────
# Thay bằng chuỗi ngẫu nhiên dài ≥ 64 ký tự trên production
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=tms-dev-secret-CHANGE-IN-PRODUCTION-use-random-64-char-string

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── PostgreSQL (để dùng sau khi swap từ in-memory sang TypeORM) ─────────────
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=tms_db
# DATABASE_USER=tms_user
# DATABASE_PASSWORD=changeme
